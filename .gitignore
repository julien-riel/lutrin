node_modules/
out.*
*.pdf
.DS_Store
packages/vscode-extension/dist/
packages/vscode-extension/latest.json
# copied from the repo root by scripts/package.mjs so it travels in the VSIX
packages/vscode-extension/THIRD-PARTY-NOTICES.md
*.vsix

# deck compilation artifacts — never versioned
*.pptx
*.html
*.deckkit
examples/assets/remote/

# the site's pages are source, not artifacts. A NEGATION PER PAGE was how this
# was written, and it swallowed the next page silently every time: `git add
# site/pricing.html` refuses, and `git add site/` skips it without a word. The
# wildcard covers every page written from now on; the re-ignore below it puts
# back the one file under site/ that really is a compilation artifact — the
# demo deck `npm run site` compiles (site/demo.pptx is already caught by *.pptx).
# ORDER MATTERS: the last matching pattern wins, so the re-ignore must follow.
!site/**/*.html
site/demo.html
# the gallery's eight specimens, compiled from examples/kits/ by
# scripts/gallery.mjs — output, exactly like demo.html above. The .deckkit
# archives it writes beside them (site/kits/) are already caught by *.deckkit.
site/gallery/

# the kit editor SPA shell is source, not a compilation artifact
!packages/core/design/editor/index.html
!packages/core/design/deck-editor/index.html

# PowerPoint-authored reference packages, fetched by scripts/reference-pptx.mjs
# (docs/reference-pptx.md says why they are never vendored)
.reference-pptx/

# local pointer to a brand kit (see scripts/package.mjs)
.brandkit

# locally generated brand kits — never versioned here (they live in their own repos)
/kits/

# internal review report — do not publish
REVUE-*.md

# Polar administration credentials — LOCAL ONLY. The shipped CLI needs no secret
# (it talks to the customer-portal endpoints, authenticated by the licence key
# itself); this token is for provisioning products and discounts from here.
.env
.env.*
!.env.example
